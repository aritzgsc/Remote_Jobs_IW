# Copia este archivo a .env para ajustar tu entorno local.
# No introduzcas credenciales reales aquí; el archivo .env no se versiona.

# Ajustes básicos de Django: usa una clave aleatoria propia antes de desplegar.
DJANGO_SECRET_KEY=replace-with-a-local-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Credenciales opcionales de OAuth de Google; déjalas vacías si no lo configuras.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Correo: la consola es cómoda en desarrollo; SMTP necesita credenciales de un proveedor.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=Remote Jobs <no-reply@remotejobs.local>
